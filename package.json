    "@vitest/coverage-v8": "^5.0.5",
    "playwright": "^1.64.1",
    "rehype-external-links": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true
  }
