---
import { getCollection } from 'astro:content';

import Button from '../components/Button.astro';
import Logo from '../components/Logo.astro';
import PlaceholderChip from '../components/PlaceholderChip.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import StatusPill from '../components/StatusPill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeSections, primaryCta } from '../lib/status';
import { whereThingsStand } from '../lib/status-rows';
import type { Edition } from '../lib/edition';

/**
 * The home page composition comes from the edition status. Changing `status` in
 * src/content/editions/2027.yaml changes this page and the nav, with no edit here.
 */
const editions = await getCollection('editions');
const current = editions
  .map((entry) => ({ ...entry.data, slug: entry.id }) as Edition)
  .filter((edition) => edition.status !== 'archived')
  .sort((a, b) => b.year - a.year)[0]!;

const sections = homeSections(current.status);
const cta = primaryCta(current.status);
const rows = whereThingsStand(current, new Date());

const FORMAT = [
  {
    title: 'A day of workshops',
    body: 'Day one is hands-on. Parallel sessions in small rooms, capped so you can actually ask a question. In 2025 we ran 17 of them.',
  },
  {
    title: 'Two days of talks and Ignites',
    body: 'A single track, so the whole room shares a reference point. Thirty-minute talks, plus Ignites: five minutes, twenty slides, auto-advancing.',
  },
  {
    title: 'Open Spaces throughout',
    body: 'Attendees propose and run the sessions. This is the centre of the event, not a side activity — the part people come back for.',
  },
];
---

<BaseLayout
  title="DevOpsDays Amsterdam"
  description="DevOpsDays Amsterdam returns for its 14th edition in 2027. Sponsorship is open now; dates, venue and the call for papers are being confirmed."
  status={current.status}
>
  {
    sections.includes('hero') && (
      <section class="hero">
        <div class="wrap hero__inner">
          {/*
            The wordmark is the page heading — we do not typeset the name beside
            it as well. It comes first in the DOM so the heading is the first
            thing announced, and so it stacks above the copy on a phone; on wider
            screens the grid places it in the right-hand column.
          */}
          <h1 class="hero__title">
            <Logo
              variant="wordmark"
              tone="dark"
              alt={`DevOpsDays Amsterdam ${current.year}`}
              width={260}
              class="hero__logo"
            />
          </h1>

          <div class="hero__text">
            <p class="hero__saveTheDate">
              <span class="hero__label">Save the date</span>
              <span class="hero__year">{current.year}</span>
            </p>

            <p class="hero__lede">
              After a year off, we are coming back for the {current.ordinal} edition.
            </p>
            <p class="hero__body">
              Three days in Amsterdam for the people who build, run and look after software.
              Workshops, a single track of talks, and Open Spaces where the agenda is yours.
              We are working on dates and a venue now.
            </p>

            <p class="hero__actions">
              {cta && <Button href={cta.href} variant="primary">{cta.label}</Button>}
              <Button href="/sponsor" variant="outline">Sponsor the conference</Button>
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    sections.includes('where-things-stand') && (
      <section class="section" id="where-things-stand">
        <div class="wrap">
          <SectionEyebrow>Where things stand</SectionEyebrow>
          <h2>What is settled, and what is not</h2>
          <p class="section__intro">
            We would rather show you the gaps than pad them out with vague prose. Each row below
            goes live the moment it is real.
          </p>

          <ul class="stand">
            {rows.map((row) => (
              <li class="stand__row">
                <span class="stand__label">{row.label}</span>
                <span class="stand__value">
                  {row.state === 'tbc' ? (
                    <PlaceholderChip>{row.value}</PlaceholderChip>
                  ) : row.href ? (
                    <a href={row.href}>
                      <StatusPill state={row.state}>{row.value}</StatusPill>
                    </a>
                  ) : (
                    <StatusPill state={row.state}>{row.value}</StatusPill>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    sections.includes('what-to-expect') && (
      <section class="section section--paper">
        <div class="wrap">
          <SectionEyebrow tone="light">What to expect</SectionEyebrow>
          <h2>The format is the part we already know</h2>
          <p class="section__intro">
            We cannot tell you who is speaking yet. We can tell you exactly how the three days work,
            because that has not changed in thirteen editions.
          </p>

          <div class="cards">
            {FORMAT.map((card) => (
              <article class="card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    sections.includes('in-the-meantime') && (
      <section class="section">
        <div class="wrap">
          <SectionEyebrow>In the meantime</SectionEyebrow>
          <h2>There is plenty to be going on with</h2>

          <div class="cards">
            <article class="card card--dark">
              <h3>Watch 2025</h3>
              <p>Forty-three speakers across three days. Every talk was recorded.</p>
              <p><a href="https://www.youtube.com/@devopsAmsterdam">Recordings on YouTube</a></p>
            </article>
            <article class="card card--dark">
              <h3>Browse the archive</h3>
              <p>Programmes, speakers and slides from previous editions.</p>
              <p><a href="/archive">Past editions</a></p>
            </article>
            <article class="card card--dark">
              <h3>Come to a meetup</h3>
              <p>DevOps Amsterdam meets through the year, between editions.</p>
              <p><a href="https://www.meetup.com/DevOpsAmsterdam/">Join the meetup group</a></p>
            </article>
          </div>
        </div>
      </section>
    )
  }

  {
    sections.includes('stay-in-touch') && (
      <section class="section stayintouch" id="stay-in-touch">
        <div class="wrap">
          <SectionEyebrow>Stay in touch</SectionEyebrow>
          <h2>We will tell you when there is something to tell</h2>
          <p class="section__intro">
            There is no mailing list yet. Until there is, these all work — and the meetup runs
            through the year, between editions.
          </p>

          <ul class="channels">
            <li>
              <a href="https://www.meetup.com/DevOpsAmsterdam/">
                <span class="channels__label">Meetup</span>
                <span class="channels__note">DevOps Amsterdam meets year round</span>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/devopsams" rel="me noopener">
                <span class="channels__label">LinkedIn</span>
                <span class="channels__note">Announcements land here first</span>
              </a>
            </li>
            <li>
              <a href="https://mastodon.social/@devopsams" rel="me noopener">
                <span class="channels__label">Mastodon</span>
                <span class="channels__note">@devopsams</span>
              </a>
            </li>
            <li>
              <a href="https://bsky.app/profile/devopsams.bsky.social" rel="me noopener">
                <span class="channels__label">Bluesky</span>
                <span class="channels__note">devopsams.bsky.social</span>
              </a>
            </li>
            <li>
              <a href={`mailto:${current.organiserEmail}`}>
                <span class="channels__label">Email us</span>
                <span class="channels__note">Ask to be told when dates are set</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    /* Tightened so the "Where things stand" rows start near the fold: the
       status block is the point of this page, not the hero. */
    padding-block: clamp(1.75rem, 4.5vw, 3.5rem);
    background: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  .hero__inner {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  /*
   * Below this width the grid collapses and DOM order applies, putting the
   * wordmark above the copy.
   */
  @media (min-width: 52rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 17rem);
      gap: 1rem 3rem;
    }

    .hero__text {
      grid-column: 1;
      grid-row: 1;
    }

    .hero__title {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
  }

  .hero__saveTheDate {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    border: 1.5px solid var(--orange);
    border-radius: var(--radius-pill);
    padding: 0.35rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .hero__label {
    font-family: var(--font-label-family, var(--font-label));
    font-size: 0.72rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero__year {
    font-family: var(--font-heading-family, var(--font-heading));
    font-weight: 800;
    color: var(--orange);
  }

  .hero__title {
    margin: 0;
  }

  .hero__logo {
    width: min(100%, 16.25rem);
  }

  .hero__lede {
    font-family: var(--font-heading-family, var(--font-heading));
    font-weight: 700;
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    line-height: 1.25;
    margin: 0 0 1rem;
  }

  .hero__body {
    color: var(--text-muted);
    max-width: 46ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
  }

  .section__intro {
    color: var(--text-muted);
    max-width: 52ch;
  }

  .section--paper .section__intro {
    color: var(--paper-muted);
  }

  /* ---- Where things stand ---- */

  .stand {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .stand__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .stand__label {
    font-family: var(--font-label-family, var(--font-label));
    font-size: 0.8rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stand__value a {
    text-decoration: none;
  }

  /* ---- Cards ---- */

  .cards {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-top: 2rem;
  }

  .card {
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-card);
    padding: 1.5rem;
  }

  .card h3 {
    margin-bottom: 0.5rem;
  }

  .card p:last-child {
    margin-bottom: 0;
  }

  .card--dark {
    border-color: var(--line);
    background: var(--card);
  }

  .card--dark p {
    color: var(--text-muted);
  }

  /* ---- Stay in touch ---- */

  .stayintouch {
    background: var(--ink);
    border-top: 1px solid var(--line);
  }

  .channels {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .channels a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    justify-content: center;
    min-height: var(--tap-target-min);
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    text-decoration: none;
    color: var(--text);
  }

  .channels a:hover {
    border-color: var(--orange);
  }

  .channels__label {
    font-family: var(--font-label-family, var(--font-label));
    font-size: 0.78rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--orange);
  }

  .channels__note {
    color: var(--text-muted);
    font-size: 0.88rem;
  }
</style>
