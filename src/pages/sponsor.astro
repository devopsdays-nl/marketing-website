---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PlaceholderChip from '../components/PlaceholderChip.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import { SITE } from '../config/site';
import { getCurrentEdition } from '../lib/current-edition';
import { joinBase } from '../lib/url';

const edition = await getCurrentEdition();

/**
 * Tiers and their limits are the ones the event runs.
 *
 * Benefits are only stated where devopsdays-web states them. The live sponsor
 * copy says exactly two things about what a tier includes: Gold gets a full
 * table, Silver gets a standing table. Everything else is [TBC] rather than
 * guessed — a sponsor deciding on a tier is making a purchase, and inventing
 * what they get for their money would be the worst possible place to be wrong.
 *
 * Prices are absent for the same reason. An old price table exists upstream but
 * is commented out, so it is not current policy.
 */
const TIERS = [
  { id: 'gold', label: 'Gold', max: 8, benefit: 'A full table, to talk to people during the breaks.' },
  { id: 'silver', label: 'Silver', max: 8, benefit: 'A standing table, to talk to people during the breaks.' },
  { id: 'bronze', label: 'Bronze', max: 10, benefit: null },
  { id: 'coffee', label: 'Coffee', max: 1, benefit: null },
  { id: 'lanyard', label: 'Lanyard', max: 1, benefit: null },
];
---

<BaseLayout
  title="Sponsor"
  description="Sponsor DevOpsDays Amsterdam 2027. Tiers, what each includes, and how to get in touch."
  status={edition.status}
>
  <section class="section">
    <div class="wrap">
      <SectionEyebrow>Sponsorship</SectionEyebrow>
      <h1>Sponsor the {edition.ordinal} edition</h1>
      <p class="lede">
        Sponsorship is open now — it is the first thing that opens, well before dates, the
        programme or tickets. If you want a say in which tier you get, this is the moment.
      </p>

      <p class="actions">
        <Button href={`mailto:${SITE.organiserEmail}?subject=Sponsoring%20DevOpsDays%20Amsterdam%20${edition.year}`}>
          Talk to us about sponsoring
        </Button>
      </p>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <SectionEyebrow tone="light">Tiers</SectionEyebrow>
      <h2>What is available</h2>
      <ul class="tiers">
        {
          TIERS.map((tier) => (
            <li class="tier">
              <div class="tier__head">
                <h3>{tier.label}</h3>
                <PlaceholderChip tone="light">[PRICE TBC]</PlaceholderChip>
              </div>
              {
                tier.benefit ? (
                  <p class="tier__blurb">{tier.benefit}</p>
                ) : (
                  <p class="tier__blurb">
                    What this tier includes for {edition.year} is{' '}
                    <PlaceholderChip tone="light">[TBC]</PlaceholderChip>
                  </p>
                )
              }
              <p class="tier__meta">
                {tier.max === 1 ? 'One sponsor only' : `Up to ${tier.max} sponsors`}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionEyebrow>What you are sponsoring</SectionEyebrow>
      <h2>Not a trade show</h2>
      <p>
        DevOpsDays is a self-organising conference for practitioners that depends on sponsorships.
        We do not have vendor booths, sell product presentations, or distribute attendee contact
        lists. Sponsors get a short elevator pitch during the programme and recognition on the
        website and on social media before, during and after the event.
      </p>
      <p>
        Sponsors are encouraged to represent themselves by actively participating and engaging with
        attendees as peers. Any attendee can demo a product or project as part of an open space
        session — including yours. This is a community conference, so heavy marketing will probably
        work against you. The best thing to do is send engineers to talk to other engineers on
        their own terms.
      </p>
      <p>
        The event runs over three days, two of them a single track — so everyone in the room sees
        the same talks, and walks past the same people between them.
      </p>
      <p>
        A prospectus with audience numbers and the benefit breakdown for {edition.year} is
        <PlaceholderChip>[PROSPECTUS TBC]</PlaceholderChip>. Email us and we will send it the moment
        it exists.
      </p>
      <p>
        You can also look at <a href={joinBase('/archive')}>past editions</a> to see who has sponsored before.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lede {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 48ch;
  }

  .actions {
    margin-top: 2rem;
  }

  .intro {
    color: var(--paper-muted);
    max-width: 48ch;
  }

  .tiers {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .tier {
    border: 1px solid var(--paper-line);
    border-radius: var(--radius-card);
    padding: 1.4rem;
  }

  .tier__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
  }

  .tier__head h3 {
    margin: 0;
  }

  .tier__blurb {
    color: var(--paper-text);
    margin-bottom: 0.6rem;
  }

  .tier__meta {
    font-family: var(--font-label-family, var(--font-label));
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-muted);
    margin: 0;
  }
</style>
