---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * Used for speakers and organisers alike.
 *
 * The round crop with the orange ring does real work: it pulls a phone selfie and
 * a studio headshot into the same shape, so a grid of 40-odd submitted photos of
 * wildly different quality still reads as one set.
 *
 * The photo is optional because the real data requires it to be — in the 2025
 * archive one speaker's declared photo does not exist. Rather than break the
 * build or ship a broken image, we fall back to initials in the same circle.
 */
interface Props {
  name: string;
  photo?: ImageMetadata;
  /** Talk title for speakers, pronouns or role for organisers. */
  secondary?: string;
  links?: { label: string; url: string }[];
  href?: string;
}
const { name, photo, secondary, links = [], href } = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .join('');
---

<article class="person">
  <div class="person__portrait">
    {
      photo ? (
        <Image src={photo} alt="" width={200} height={200} class="person__photo" loading="lazy" />
      ) : (
        <span class="person__initials" aria-hidden="true">{initials}</span>
      )
    }
  </div>

  <h3 class="person__name">
    {href ? <a href={href}>{name}</a> : name}
  </h3>

  {secondary && <p class="person__secondary">{secondary}</p>}

  {
    links.length > 0 && (
      <ul class="person__links">
        {links.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="me noopener noreferrer">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .person {
    text-align: center;
  }

  .person__portrait {
    width: 128px;
    height: 128px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    border: var(--ring-width) solid var(--orange);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--card);
  }

  .person__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__initials {
    font-family: var(--font-heading-family, var(--font-heading));
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--orange);
  }

  .person__name {
    font-size: 1.05rem;
    margin: 0 0 0.25rem;
  }

  .person__name a {
    color: inherit;
    text-decoration: none;
  }

  .person__name a:hover {
    text-decoration: underline;
  }

  .person__secondary {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0;
    max-width: none;
  }

  .person__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: center;
    padding: 0;
    margin: 0.6rem 0 0;
  }

  .person__links a {
    display: inline-block;
    font-family: var(--font-label-family, var(--font-label));
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.6rem;
  }

  .person__links a:hover {
    color: var(--orange);
    border-color: var(--orange);
  }
</style>
