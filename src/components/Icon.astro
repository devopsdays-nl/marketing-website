---
import { BRAND_ICONS } from '../assets/icons/brands';

/**
 * Small inline icons, drawn in currentColor so they take the surrounding colour
 * and stay readable on both dark and light sections.
 *
 * Brand marks come from simple-icons (CC0). Two exceptions:
 *  - `email` is a plain envelope, not a brand mark.
 *  - `linkedin` is hand-drawn. simple-icons removed LinkedIn following a
 *    trademark request, so this only approximates the official mark; swap in
 *    LinkedIn's own asset if that matters.
 *
 * Always decorative here: every icon sits next to a visible text label, so it is
 * hidden from assistive technology rather than repeating the label aloud.
 */
interface Props {
  name: 'meetup' | 'mastodon' | 'bluesky' | 'linkedin' | 'email';
  size?: number;
}
const { name, size = 22 } = Astro.props;

const LINKEDIN =
  'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13M7.12 20.45H3.55V9h3.57zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0';

const EMAIL =
  'M2.5 5h19A1.5 1.5 0 0 1 23 6.5v11a1.5 1.5 0 0 1-1.5 1.5h-19A1.5 1.5 0 0 1 1 17.5v-11A1.5 1.5 0 0 1 2.5 5m.9 2 8.6 5.73L20.6 7zM3 8.87V17h18V8.87l-8.45 5.63a1 1 0 0 1-1.1 0z';

const PATHS: Record<Props['name'], string> = {
  ...BRAND_ICONS,
  linkedin: LINKEDIN,
  email: EMAIL,
};
---

<svg
  class="icon"
  role="presentation"
  aria-hidden="true"
  focusable="false"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
>
  <path d={PATHS[name]} />
</svg>

<style>
  .icon {
    display: block;
    flex-shrink: 0;
  }
</style>
