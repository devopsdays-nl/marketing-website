---
/**
 * Session type, as a pill. Talk and Workshop are filled; Ignite and Open Space
 * are outlined, which keeps a single-track day from turning into a wall of
 * orange blocks.
 *
 * Workshop uses --orange-deep-fill rather than --orange-deep: the true brand
 * secondary is too dark for ink text on top (4.36:1), and this lifted variant
 * clears AA at 4.86:1.
 */
interface Props {
  type: 'talk' | 'workshop' | 'ignite' | 'open-space' | 'custom';
}
const { type } = Astro.props;

const LABELS = {
  talk: 'Talk',
  workshop: 'Workshop',
  ignite: 'Ignite',
  'open-space': 'Open Space',
  custom: 'Break',
} as const;
---

<span class:list={['badge', `badge--${type}`]}>{LABELS[type]}</span>

<style>
  .badge {
    display: inline-block;
    font-family: var(--font-label-family, var(--font-label));
    font-weight: 500;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--radius-pill);
    padding: 0.2rem 0.7rem;
    white-space: nowrap;
    border: 1.5px solid transparent;
  }

  .badge--talk {
    background: var(--orange);
    color: var(--ink);
  }

  .badge--workshop {
    background: var(--orange-deep-fill);
    color: var(--ink);
  }

  .badge--ignite {
    color: var(--orange);
    border-color: var(--orange);
  }

  .badge--open-space {
    color: var(--text-muted);
    border-color: var(--line);
  }

  .badge--custom {
    color: var(--text-muted);
    border-color: transparent;
  }
</style>
