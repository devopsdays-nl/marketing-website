---
import { Font } from 'astro:assets';

import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import { SITE, absoluteUrl } from '../config/site';
import { joinBase } from '../lib/url';
import type { EditionStatus } from '../lib/status';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  status: EditionStatus;
  noindex?: boolean;
}
const { title, description, status, noindex = false } = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname);

/**
 * Link previews need an absolute URL — a relative one renders as a broken
 * image placeholder, which is what Slack and LinkedIn were showing. Built from
 * SITE.url and the base path so it stays correct on any host.
 */
const ogImage = absoluteUrl(joinBase('/og-image.png'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/*
      The Pakhuis de Zwijger building from the logo lockup. The wordmark is a
      four-row stack and is unreadable at 16px, so the building is used instead —
      it is the part of the mark that still works as a tiny square.
      Generated by scripts/favicon.mjs.
    */}
    <link rel="icon" type="image/svg+xml" href={joinBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={joinBase('/favicon-32.png')} />
    <link rel="apple-touch-icon" href={joinBase('/apple-touch-icon.png')} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DevOpsDays Amsterdam — save the date, 2027" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-heading-family" preload />
    <Font cssVariable="--font-body-family" preload />
    <Font cssVariable="--font-label-family" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav status={status} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
